# Docker Compose local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prisma_lms
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d
JWT_ISSUER=prisma-lms-api
JWT_AUDIENCE=prisma-lms-client
NODE_ENV=development

# Execucao fora do Docker (npm run dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prisma_lms
MONGO_URL=mongodb://localhost:27017/prisma_lms
PORT=3000
